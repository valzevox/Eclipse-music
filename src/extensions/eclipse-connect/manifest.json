{
  "manifest_version": 3,
  "name": "Eclipse Connect",
  "version": "1.0.0",
  "description": "Secure one-time session connector for Eclipse Music Player",
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "https://open.spotify.com/*"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Connect to Eclipse"
  },
  "background": {
    "service_worker": "background.js"
  }
}
