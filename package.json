{
  "name": "eclipse",
  "version": "1.5.2",
  "main": "src/main/main.js",
  "bin": {
    "eclipse": "src/main/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build:extension": "node scripts/build-extension.js",
    "predist": "npm run build:extension",
    "dist": "electron-builder",
    "conveyor:app": "conveyor --cache-free-space-limit=1 make --overwrite=HARD_REPLACE app",
    "conveyor:site": "conveyor --cache-free-space-limit=1 make --overwrite=HARD_REPLACE site",
    "release:preflight": "node scripts/release-preflight.js",
    "release:verify-manifest": "node scripts/verify-release-manifest.js",
    "release:provenance": "node scripts/generate-provenance.js",
    "release": "echo \"Direct npm version/push is disabled. Run npm run release:preflight and use the Release Gate workflow.\" && exit 1",
    "release:minor": "echo \"Direct npm version/push is disabled. Run npm run release:preflight and use the Release Gate workflow.\" && exit 1",
    "release:major": "echo \"Direct npm version/push is disabled. Run npm run release:preflight and use the Release Gate workflow.\" && exit 1"
  },
  "keywords": [],
  "author": "Eclipse Team",
  "license": "MIT",
  "description": "Eclipse - modern high-fidelity audio player.",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.1",
    "tone": "^15.1.22",
    "ws": "^8.22.2",
    "youtubei.js": "^18.3.0"
  },
  "productName": "Eclipse",
  "homepage": "https://github.com/valzevox/Eclipse-music",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valzevox/Eclipse-music.git"
  },
  "bugs": {
    "url": "https://github.com/valzevox/Eclipse-music/issues"
  },
  "build": {
    "appId": "io.github.eclipse.app",
    "productName": "Eclipse",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "valzevox",
        "repo": "Eclipse-music",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": "dist/extension/eclipse-connect.zip",
        "to": "extension/eclipse-connect.zip"
      }
    ],
    "afterPack": "src/main/afterPack.js"
  }
}
